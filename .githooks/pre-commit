#!/usr/bin/env bash

if command -v pre-commit &>/dev/null; then
    exec pre-commit run --hook-stage pre-commit
elif command -v gitleaks &>/dev/null; then
    echo "ℹ️  pre-commit not installed. Running gitleaks directly..."
    echo ""
    exec gitleaks protect --staged --verbose --redact
else
    echo ""
    echo "⚠️  Neither pre-commit nor gitleaks is installed."
    echo ""
    echo "Install one of them to enable local secret scanning:"
    echo ""
    echo "  brew install pre-commit   # OR: brew install gitleaks"
    echo ""
    echo "Continuing without secret scan. CI will still catch secrets on push."
    echo ""
fi
