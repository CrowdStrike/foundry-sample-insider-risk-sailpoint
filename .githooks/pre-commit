#!/usr/bin/env bash

if command -v pre-commit &>/dev/null; then
    exec pre-commit run --hook-stage pre-commit
else
    echo ""
    echo "❌ Commit blocked: pre-commit is not installed."
    echo ""
    echo "Install pre-commit to enable commits:"
    echo ""
    echo "  pip install pre-commit"
    echo ""
    exit 1
fi
